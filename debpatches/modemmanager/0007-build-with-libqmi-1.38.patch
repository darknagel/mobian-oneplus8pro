From: Timo <1788603+darknagel@users.noreply.github.com>
Subject: [PATCH] build with libqmi 1.38 (Debian forky)

QMI_VOICE_CALL_STATE_PRE_ALERTING, QMI_WDS_PDP_TYPE_NON_IP and
QMI_DATA_ENDPOINT_TYPE_ETHERNET only exist in newer libqmi. Drop their
case labels; the values then take the default branch.
---
--- a/src/mm-broadband-modem-qmi.c
+++ b/src/mm-broadband-modem-qmi.c
@@ -11642,7 +11642,6 @@
                 case QMI_VOICE_CALL_STATE_CC_IN_PROGRESS:
                     call_info->state = MM_CALL_STATE_DIALING;
                     break;
-                case QMI_VOICE_CALL_STATE_PRE_ALERTING:
                 case QMI_VOICE_CALL_STATE_ALERTING:
                     call_info->state = MM_CALL_STATE_RINGING_OUT;
                     break;
@@ -12086,7 +12085,6 @@
                 case QMI_VOICE_CALL_STATE_CC_IN_PROGRESS:
                     call_info->state = MM_CALL_STATE_DIALING;
                     break;
-                case QMI_VOICE_CALL_STATE_PRE_ALERTING:
                 case QMI_VOICE_CALL_STATE_ALERTING:
                     call_info->state = MM_CALL_STATE_RINGING_OUT;
                     break;
--- a/src/mm-modem-helpers-qmi.c
+++ b/src/mm-modem-helpers-qmi.c
@@ -2373,7 +2373,6 @@
     case QMI_WDS_PDP_TYPE_IPV4_OR_IPV6:
         return MM_BEARER_IP_FAMILY_IPV4V6;
     case QMI_WDS_PDP_TYPE_PPP:
-    case QMI_WDS_PDP_TYPE_NON_IP:
     default:
         return MM_BEARER_IP_FAMILY_NONE;
     }
--- a/src/mm-port-qmi.c
+++ b/src/mm-port-qmi.c
@@ -160,7 +160,6 @@
         case QMI_DATA_ENDPOINT_TYPE_UNDEFINED:
         case QMI_DATA_ENDPOINT_TYPE_HSIC:
         case QMI_DATA_ENDPOINT_TYPE_BAM_DMUX:
-        case QMI_DATA_ENDPOINT_TYPE_ETHERNET:
         case QMI_DATA_ENDPOINT_TYPE_UNKNOWN:
         default:
             self->priv->endpoint_interface_number = 0;
